<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.usb.host" android:required="true" />

    <!-- ROMs chinas (ZUI PRC): permiso extra para leer la lista de apps instaladas. -->
    <uses-permission android:name="com.android.permission.GET_INSTALLED_APPS" />

    <!-- Pantalla 16:9 sin Shizuku. No se pide en la app: se da una vez con
         adb shell pm grant io.github.sudodiego.g9control android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Liberar memoria desde Inicio: cerrar las apps que quedaron en segundo plano (permiso normal, sin pedirlo). -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- Para listar las apps instaladas en la página de cambio automático. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Pantallas de inicio (por ejemplo Cocoon Shell): cuentan como "salir del juego". -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Game Assistant de ZUI: saber si está instalado y abrir sus ajustes. -->
        <package android:name="com.zui.game.service" />
        <!-- Shizuku: abrirlo desde la pestaña Tablet si no está iniciado. -->
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Al conectar el G9 en modo Android, Android le avisa a esta pantalla invisible (no abre la app)
             y puede recordar el permiso USB con "Usar siempre". -->
        <activity
            android:name=".UsbAttachActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/g9_device_filter" />
        </activity>

        <service
            android:name=".AndroidTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="Android"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".XInputTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="X-Input"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".Ds5TileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="DS5"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".AutoModeService"
            android:exported="true"
            android:label="@string/auto_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/auto_mode_service" />
        </service>

        <!-- Shizuku entrega su binder por aquí (ver Shell.kt). -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
